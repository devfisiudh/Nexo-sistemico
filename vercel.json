{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/noticias", "destination": "/pages/noticias" },
    { "source": "/eventos", "destination": "/pages/eventos" },
    { "source": "/comunidad", "destination": "/pages/comunidad" },
    { "source": "/nosotros", "destination": "/pages/nosotros" },
    { "source": "/contacto", "destination": "/pages/contacto" },
    { "source": "/articulo", "destination": "/pages/articulo" },
    { "source": "/evento", "destination": "/pages/evento" },
    { "source": "/proyectos/rastreo-bus", "destination": "/pages/proyectos/rastreo-bus" },
    { "source": "/", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },

        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://gkunrwknbuoevylyuftl.supabase.co; connect-src 'self' https://gkunrwknbuoevylyuftl.supabase.co https://*.supabase.co; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
